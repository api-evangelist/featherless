{
  "opencollection": "1.0.0",
  "info": {
    "name": "Featherless AI Chat Completions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Completions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a text completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.featherless.ai/v1/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a text completion for the provided prompt. OpenAI compatible. The `prompt` may be a string or an array of strings; an array is treated as a parallel inference call. Supports streaming via `stream: true`."
        }
      ]
    }
  ],
  "bundled": true
}