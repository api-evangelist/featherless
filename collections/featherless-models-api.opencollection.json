{
  "opencollection": "1.0.0",
  "info": {
    "name": "Featherless AI Chat Models API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.featherless.ai/v1/models"
          },
          "docs": "Lists the open-weight models available for serverless inference on Featherless AI. OpenAI compatible."
        }
      ]
    }
  ],
  "bundled": true
}