{
  "opencollection": "1.0.0",
  "info": {
    "name": "Featherless AI Chat Embeddings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Embeddings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create embeddings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.featherless.ai/v1/embeddings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns vector embeddings for the supplied input using an open embedding model (for example Qwen/Qwen3-Embedding-8B). OpenAI compatible."
        }
      ]
    }
  ],
  "bundled": true
}